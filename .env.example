# Copy the two lines below into the .env that `npx e9core setup` creates.
# setup writes E9_ADMIN_API_KEY, E9_PUBLIC_API_KEY, SESSION_SECRET and
# E9_SETUP_TOKEN there itself — don't add those by hand.

# From https://console.anthropic.com/ → API keys
ANTHROPIC_API_KEY=sk-ant-...

# The Google service account key. Paste the JSON on one line, or base64 it:
#   base64 -i service-account.json | tr -d '\n'
GOOGLE_SERVICE_ACCOUNT_JSON=
