{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "xennialmemes",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "build": {
    "command": "npx e9core build-plugins"
  },
  "alias": {
    "@engine9/core/plugins/site": "./engine9.plugins.js",
    "@engine9/input-tools": "@engine9/core/cloudflare/input-tools-shim",
    "knex": "@engine9/core/cloudflare/unavailable-module",
    "mysql2": "@engine9/core/cloudflare/unavailable-module",
    "mysql2/promise": "@engine9/core/cloudflare/unavailable-module",
    "better-sqlite3": "@engine9/core/cloudflare/unavailable-module",
    "i18n-iso-countries": "i18n-iso-countries/index.js"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "engine9",
      "database_id": "2cb65c69-bcbc-46c0-8cad-3fb47c996396",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "xennialmemes-media"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "triggers": {
    "crons": [
      "*/10 * * * *",
      "23 8 * * *"
    ]
  },
  "vars": {
    "SITE_URL": "https://xennialmemes.com",
    "SITE_NAME": "Xennial Memes",
    "CLAUDE_MODEL": "claude-sonnet-5-5",
    "INGEST_BATCH": "5",
    "TAG_AUTOMERGE": "true",
    "TAG_DESCRIBE_MIN": "3",
    "DELEGATE_URL": "https://delegate.engine9.ai",
    "DRIVE_FOLDER_ID": "1I4fxWJ9zSvoX4I7EOIs_YEbCFXJVG3NT",
    "ADMIN_EMAILS": "rader.m@gmail.com",
    "E9_ACCOUNT_ID": "my-site",
    "E9_PLUGIN_ID": "6e1f8877-5327-5003-b805-c4b5265cedac"
  },
  "routes": [
    {
      "pattern": "xennialmemes.com",
      "custom_domain": true
    },
    {
      "pattern": "www.xennialmemes.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
